# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database

# JWT Configuration
JWT_ACCESS_TOKEN_PRIVATE_KEY=your_access_token_private_key
JWT_ACCESS_TOKEN_PUBLIC_KEY=your_access_token_public_key
JWT_REFRESH_TOKEN_PRIVATE_KEY=your_refresh_token_private_key
JWT_REFRESH_TOKEN_PUBLIC_KEY=your_refresh_token_public_key

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# AWS Configuration (Optional)
# ACCESS_KEY=your_aws_access_key
# ACCESS_SECRET=your_aws_secret_key
# BUCKET_NAME=your_bucket_name
# REGION=your_region

# Digital Ocean Spaces (if using)
DO_SPACES_KEY=your_do_spaces_key
DO_SPACES_SECRET=your_do_spaces_secret
DO_SPACES_BUCKET=your_bucket_name
DO_SPACES_REGION=your_region

# Application Configuration
APP_BASE_URL=http://localhost:4000
PORT=4000

# Admin Seed Data
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=YourStrongPassword@123
SEED_ADMIN_PHONE=9999999999

# CORS Configuration
ADDITIONAL_ORIGINS=http://localhost:3000,http://localhost:5173